# ==========================================
# ReliefChain Environment Configuration
# ==========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# 1. Database Configuration (packages/database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reliefchain?schema=public"

# 2. Redis Configuration (apps/api, event indexer)
REDIS_URL="redis://localhost:6379"

# 3. Backend API Configuration (apps/api)
PORT=3001
JWT_SECRET="dev-jwt-secret-change-in-production"

# 4. Frontend Configuration (apps/web)
NEXT_PUBLIC_API_URL="http://localhost:3001"

# 5. Blockchain & RPC Configuration (apps/api, packages/contracts)
RPC_URL="http://127.0.0.1:8545"
RPC_ENDPOINT="http://127.0.0.1:8545"
CHAIN_ID=31337

# 6. Contract Addresses (populated after local deployment via deploy-local.ts)
DISASTER_REGISTRY_ADDRESS=""
CAMPAIGN_REGISTRY_ADDRESS=""
DONATION_CONTRACT_ADDRESS=""
CAMPAIGN_ESCROW_ADDRESS=""
ALLOCATION_MULTISIG_ADDRESS=""
RESOURCE_PROVENANCE_ADDRESS=""

# 7. Relayer Configuration (apps/api)
# For local Hardhat testing, insert the 6th default Hardhat account private key (Account #5)
SYSTEM_INDEXER_PRIVATE_KEY=""

# 8. AI Service Configuration (apps/ai-service)
AI_SERVICE_URL="http://localhost:8000"

# 9. IPFS/Object Storage (apps/api) — mock for development
IPFS_GATEWAY="https://ipfs.io/ipfs/"
PINATA_API_KEY="placeholder"
PINATA_SECRET_API_KEY="placeholder"

# 10. Hardhat Deployment (packages/contracts)
# Only used for testnet deployment, not for local Hardhat node
# SEPOLIA_RPC_URL=""
# DEPLOYER_PRIVATE_KEY=""
